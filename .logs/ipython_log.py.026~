def show_staged_info(dev):
    print(f"{dev.name}: staged={dev._staged}")
    print("stage_sigs:")
    for k, v in getattr(dev, "stage_sigs", {}).items():
        print(f"  {k} -> {v}")

    print("original values saved:")
    for sig, val in getattr(dev, "_original_vals", {}).items():
        pv = getattr(sig, "pvname", "no-pv")
        print(f"  {sig.name} ({pv}) original={val}")

    print("children:")
    for name in getattr(dev, "component_names", []):
        child = getattr(dev, name)
        if hasattr(child, "_staged"):
            print(f"  {name}: {child._staged}")

